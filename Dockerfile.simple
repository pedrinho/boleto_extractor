# Container image for Render.
#
# Every Python dependency ships a self-contained wheel, so there are no apt
# packages to install: the previous libzbar/OpenCV system libraries went away
# with the move from pyzbar+opencv to zxing-cpp.
FROM python:3.13-slim-bookworm

WORKDIR /app

# Copy requirements first for better layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

EXPOSE 3000

ENV FLASK_ENV=production
ENV PORT=3000

# SECRET_KEY must be provided by the environment - the app refuses to start in
# production without one.
CMD ["sh", "-c", "gunicorn -w 2 -b 0.0.0.0:${PORT:-3000} app:app"]
