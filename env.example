# Environment variables for Boleto Extractor Web App
# Copy this file to .env and set your values. ./start loads .env automatically.

# Flask Configuration
FLASK_ENV=development
PORT=3000

# Interface the development server (./start) listens on. Defaults to localhost:
# in development mode the Werkzeug debugger runs, and it executes code for anyone
# who can reach it. Only change this on a network you trust.
HOST=127.0.0.1

# Maximum upload size in MB. Keep this at or below your host's request body
# limit. Vercel rejects bodies larger than 4.5MB before the app ever sees them,
# so 4 is the safe default there.
MAX_UPLOAD_MB=4

# Public JSON API at /api/extract. Disabled (404) unless explicitly enabled.
ENABLE_PUBLIC_API=false

# If set, /api/extract requires a matching X-API-Key header.
# API_KEY=some-long-random-string
